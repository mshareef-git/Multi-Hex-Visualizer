---
import "../styles/studio.css";
import SiteFooter from "../components/SiteFooter.astro";

interface Props { title: string; description: string; path: string; }
const { title, description, path } = Astro.props;
const canonicalUrl = `https://mshareef-git.github.io/Multi-Hex-Visualizer${path}`;
const ogImage = "https://mshareef-git.github.io/Multi-Hex-Visualizer/og-image.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Multi Hex Visualizer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      try {
        document.documentElement.toggleAttribute("data-dark", localStorage.getItem("multihex-theme") === "Dark");
      } catch {}
    </script>
    <title>{title}</title>
  </head>
  <body>
    <header>
      <div class="bar shell">
        <a class="brand" href="/">
          <span class="brandmark" aria-hidden="true"><i></i><i></i><i></i></span>
          Multi Hex<span class="brandlight">Visualizer</span>
        </a>
        <a class="back-link" href="/">Open visualizer</a>
      </div>
    </header>
    <main class="legal shell"><slot /></main>
    <SiteFooter />
  </body>
</html>

<style>
  .back-link { color: var(--muted); font-size: 0.86rem; text-underline-offset: 4px; }
  .legal { width: min(760px, 89%); padding: clamp(56px, 9vw, 110px) 0 36px; }
  .legal :global(h1) { margin: 0 0 18px; max-width: none; font-size: clamp(2.8rem, 7vw, 5.2rem); }
  .legal :global(.updated) { color: var(--muted); font: 0.78rem/1.4 var(--mono); margin-bottom: 48px; }
  .legal :global(h2) { margin: 46px 0 12px; font-size: 1.42rem; letter-spacing: -0.025em; }
  .legal :global(p), .legal :global(li) { color: var(--muted); line-height: 1.72; }
  .legal :global(a) { color: var(--ink); text-underline-offset: 3px; }
  .legal :global(li + li) { margin-top: 8px; }
</style>
